{
  "name": "lowscript",
  "version": "0.0.6",
  "author": "Timur Shemsedinov <timur.shemsedinov@gmail.com>",
  "license": "MIT",
  "description": "Lowcode is a limited subset of JavaScript for low-code with Metarhia technology stack",
  "keywords": [
    "node.js",
    "metarhia",
    "lowcode",
    "nocode",
    "javascript",
    "markdown",
    "dsl",
    "bpmn"
  ],
  "main": "lowscript.js",
  "files": [
    "lib/",
    "lowscript.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metarhia/lowscript.git"
  },
  "bugs": {
    "url": "https://github.com/metarhia/lowscript/issues",
    "email": "timur.shemsedinov@gmail.com"
  },
  "homepage": "https://metarhia.com",
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/tshemsedinov"
  },
  "scripts": {
    "build": "metarhia-build lib",
    "test": "npm run lint && npm run types && node --test",
    "types": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check \"**/*.js\" \"**/*.json\" \"**/*.md\" \"**/*.ts\"",
    "fix": "eslint . --fix && prettier --write \"**/*.js\" \"**/*.json\" \"**/*.md\" \"**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "eslint": "^9.39.5",
    "eslint-config-metarhia": "^9.1.9",
    "metarhia-build": "^0.0.3",
    "metaskills": "^1.0.4",
    "metatests": "^0.9.3",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "metaschema": "^2.2.2",
    "metautil": "^5.5.2",
    "metavm": "^1.2.1"
  }
}
